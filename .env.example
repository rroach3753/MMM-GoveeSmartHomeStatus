# Required for cloud status requests
GOVEE_API_KEY=YOUR_GOVEE_API_KEY

# Optional Homebridge read-only wattage integration
HOMEBRIDGE_URL=https://homebridge.local:8581
HOMEBRIDGE_USERNAME=admin
HOMEBRIDGE_PASSWORD=yourpassword
HOMEBRIDGE_VERIFY_SSL=true

# Optional privileged outlet auto-off policy (disabled unless explicitly enabled)
HOMEBRIDGE_AUTO_OFF_ENABLED=false
# HOMEBRIDGE_AUTO_OFF_DEVICE_NAME=eBike - Pro
# HOMEBRIDGE_AUTO_OFF_THRESHOLD_WATTS=5
# HOMEBRIDGE_AUTO_OFF_ARM_WATTS=20
# HOMEBRIDGE_AUTO_OFF_BELOW_DURATION_MS=300000
# HOMEBRIDGE_AUTO_OFF_POLL_INTERVAL_MS=30000

# Optional privileged presence/display policy (disabled unless explicitly enabled)
PRESENCE_DISPLAY_CONTROL_ENABLED=false
# PRESENCE_DISPLAY_SENSOR_NAME=Hallway - Sensor
# PRESENCE_DISPLAY_OFF_DELAY_MS=300000
# PRESENCE_DISPLAY_POLL_INTERVAL_MS=15000
# PRESENCE_DISPLAY_OUTPUT=HDMI-A-1
